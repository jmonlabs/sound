{
  "tasks": {
    "test": "node --test tests/*.test.js"
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["node_modules/", "tests/"]
  },
  "fmt": {
    "include": ["src/", "tests/"],
    "exclude": ["node_modules/"],
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  }
}
